# Optional. Enables Claude-based narrative/event scoring. Without it, heuristics are used.
ANTHROPIC_API_KEY=
# paper | live   (live is NOT implemented in this version and will refuse to start)
TRADING_MODE=paper
LOG_LEVEL=info
DB_PATH=data/memecoinbot.db
STRATEGY_CONFIG=config/strategy.yaml
# Dashboard display only: ledger amounts are always USD and converted in the browser. AUD | USD (default AUD).
DISPLAY_CURRENCY=AUD
# IANA time zone for dashboard timestamps (default Australia/Sydney; an unknown zone falls back to the default).
DISPLAY_TIMEZONE=Australia/Sydney
# Timezone whose midnight resets the daily loss breaker (validated; invalid values fall back to Australia/Sydney).
TRADING_DAY_TIMEZONE=Australia/Sydney
# Dashboard bind address and port. Keep 127.0.0.1 unless binding to a Tailscale IP (100.x.y.z) on a server.
UI_HOST=127.0.0.1
UI_PORT=4777
